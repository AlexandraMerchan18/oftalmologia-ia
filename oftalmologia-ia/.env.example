# =====================================================================================
#  Oftalmología + IA — variables de entorno
#  1) Copie este archivo:  cp .env.example .env   (./run.sh lo hace solo si no existe)
#  2) Pegue SU llave en la variable del proveedor elegido. NUNCA suba .env al repositorio.
#  Los comentarios van siempre en su propia línea (no al final de un valor).
# =====================================================================================

# ---------- 1. Proveedor LLM (extracción + explicación) ----------
# Valores posibles: groq | gemini | openai | mock
#   groq   -> modelo por defecto openai/gpt-oss-120b  (recomendado: más rápido y barato)
#   gemini -> modelo por defecto gemini-2.5-flash
#   openai -> modelo por defecto gpt-4o-mini
#   mock   -> IA simulada por reglas: sin red ni llaves (solo pruebas o plan B de la demo)
LLM_PROVIDER=groq

# Llave del proveedor elegido (solo se usa la que corresponde a LLM_PROVIDER).
# Groq:   https://console.groq.com/keys
# Gemini: https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Vacío = modelo por defecto del proveedor. Ejemplo para cambiarlo: LLM_MODEL=openai/gpt-oss-20b
LLM_MODEL=

# ---------- 2. Transcripción (Whisper) ----------
# local -> faster-whisper dentro del contenedor (el audio no sale del equipo)
# groq  -> whisper-large-v3-turbo en Groq (más rápido; requiere GROQ_API_KEY)
TRANSCRIPCION_PROVIDER=local
# Modelo local: tiny | base | small | medium. "small" = buen balance en español con CPU.
WHISPER_MODEL=small
# true = el modelo se descarga al construir la imagen (la demo no espera descargas).
PRECARGAR_WHISPER=true

# ---------- 3. Base de datos (PostgreSQL en Docker) ----------
POSTGRES_DB=oftalmologia
POSTGRES_USER=oftalmologia
POSTGRES_PASSWORD=oftalmologia_local
# Informativo: docker-compose.yml construye esta URL automáticamente para el contenedor backend.
DATABASE_URL=postgresql+psycopg://oftalmologia:oftalmologia_local@db:5432/oftalmologia

# ---------- 4. Límites del agente (los 4 límites activos) ----------
AGENTE_MAX_ITERACIONES=5
AGENTE_TIMEOUT_S=60
AGENTE_MAX_TOKENS_TOTALES=20000
LLM_TIMEOUT_S=30
LLM_MAX_TOKENS_RESPUESTA=4096
LLM_TEMPERATURE=0

# ---------- 5. Demo y puertos ----------
# Permite "Armar fallo" desde el panel de trazas (timeout, caída, 429, JSON roto).
PERMITIR_SIMULAR_FALLAS=true
PUERTO_WEB=8080
PUERTO_API=8000
